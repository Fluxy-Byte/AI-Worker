PORT=7088

# Nome do Agent (Agent Console) que ESTA instância atende — define a fila
# consumida (task.agent.<nome-sanitizado>.create). Uma instância = um agente.
AGENT_NAME="barbearia"

# Nome fantasia da barbearia usado nas mensagens do agente.
BARBEARIA_NOME="barbearia"

# Nome da fila de atendimento humano sugerida no handoff — precisa bater com o
# nome real da fila criada no Agent Console pra ilha da barbearia.
BARBEARIA_FILA_ATENDIMENTO="Atendimento Humano - Barbearia"

URL_RABBITMQ="amqp://user:password@host:5672"

URL_ADK_SESSIONS="postgresql+asyncpg://user:password@host:5432/operation"

URL_PGVECTOR="postgresql+psycopg://user:password@host:5432/fluxe?sslmode=disable"

AGENT_API_BASE_URL="http://localhost:7073"
INTERNAL_API_KEY=

OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_ADK_MODEL=gemini-flash-latest
GOOGLE_ADK_APP_NAME=generic

SEAWEEDFS_S3_ENDPOINT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
SEAWEEDFS_S3_BUCKET=
SEAWEEDFS_S3_REGION=us-east-1
