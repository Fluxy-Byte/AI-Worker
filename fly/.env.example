PORT=7084

# Nome do Agent (Agent Console) que ESTA instância atende — define a fila
# consumida (task.agent.<nome-sanitizado>.create). Uma instância = um agente.
AGENT_NAME="fly"

URL_RABBITMQ="amqp://user:password@host:5672"

URL_ADK_SESSIONS="postgresql+asyncpg://user:password@host:5432/operation"

# Agent-Api — usado pra buscar filas da ilha de atendimento no handoff e pra
# sincronizar metadata do contato (telefone informado manualmente).
AGENT_API_BASE_URL="http://localhost:7084"
INTERNAL_API_KEY=

# fluxy-gestao-be — API interna do produto de gestão de OS (distinta do
# Agent-Api acima), usada para autorizar e consultar clientes/OS/serviços da
# conta do contato pelo telefone (/api/internal/assistant). Ver
# fluxy-gestao-be/src/infrastructure/auth/require-internal-service.middleware.ts
# — a chave precisa bater com o INTERNAL_API_KEY configurado lá.
FLUXY_GESTAO_API_BASE_URL="http://localhost:6501"
FLUXY_GESTAO_INTERNAL_API_KEY=

OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_ADK_MODEL=gemini-flash-latest
GOOGLE_ADK_APP_NAME=fly
